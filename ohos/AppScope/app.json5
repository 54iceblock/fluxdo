{
  "app": {
    "bundleName": "com.fluxdo.app",
    "vendor": "fluxdo",
    // 与 repo/pubspec.yaml 的 version 0.2.29+2026102016 保持一致。
    // 注意：flutter build hap 会用 pubspec 重新覆盖这两个字段
    // （见 tools/flutter/packages/flutter_tools/lib/src/ohos/hvigor_utils.dart:updateProjectVersion）。
    "versionCode": 2026102016,
    "versionName": "0.2.29",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    // HarmonyOS 7（API 26+）备用图标：深色模式下由 EntryAbility 切到 dark；浅色恢复默认 icon。
    "alternateIcons": [
      { "name": "dark", "icon": "$media:app_icon_dark" }
    ]
  }
}
