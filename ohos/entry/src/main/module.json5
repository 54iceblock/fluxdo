{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 深链：对应 lib/services/deep_link_service.dart 处理的 scheme
            //   fluxdo://topic/123、fluxdo://user/xxx
            //   discourse://auth_redirect?payload=...（浏览器授权登录回调）
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "fluxdo"
              },
              {
                "scheme": "discourse"
              }
            ]
          }
          // TODO(ohos): https://linux.do/t/、/u/、/session/email-login/ 的应用链接
          // 需要先在 AGC 完成 App Linking 域名校验，之后再补：
          // { "scheme": "https", "host": "linux.do", "pathStartWith": "/t/" }
        ]
      }
    ],
    // 权限收敛原则：只声明「应用代码真的会用到」的权限，上架审核会逐项核对。
    // 依据 docs/ohos-plugin-matrix.md §3.1；受限权限（READ_IMAGEVIDEO 等）刻意不声明。
    // 注：富文本「读」剪贴板 ohos.permission.READ_PASTEBOARD 属 system_basic 级，
    // 普通应用证书安装期即失败（grant request permissions failed），故不声明；
    // 读取能力已整体移除，粘贴一律降级为纯文本。
    // 「写」图片到剪贴板不需要该权限（ArkTS 桥 writeImageToPasteboard）。
    //
    // 已移除本应用对 ohos.permission.PUBLISH_AGENT_REMINDER 的声明：
    // 该权限只用于 reminderAgentManager 发布**定时提醒**，而本应用的本地通知只走
    // notificationManager 即时 publish（lib/services/local_notification_service.dart
    // 只调用 show()，没有 zonedSchedule），声明它属于「声明了但不用」。
    //
    // ⚠️ 依赖 HAR 声明的权限会被 hvigor 合并进最终 HAP：flutter_local_notifications
    // 的 HAR 原本自带该权限，只删这里无效（2026-10 解包实测）。因此该插件已 vendored
    // 到 packages/flutter_local_notifications 并删掉了其 module.json5 里的条目。
    // 新增依赖时同样要解包 HAP 核对最终权限集合，不能只看本文件。
    "requestPermissions": [
      {
        // 全部网络请求（dio / WebView / DOH 代理）
        "name": "ohos.permission.INTERNET"
      },
      {
        // 判断网络可用性（连接类型变化时刷新）
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // 扫码登录 / 相机扫码（mobile_scanner）
        "name": "ohos.permission.CAMERA",
        "reason": "$string:reason_camera",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // 语音消息录制（record）
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:reason_microphone",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
