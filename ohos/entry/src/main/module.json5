{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 后台保活：数据同步类长时任务（后台消息轮询用；单次最长约 10 分钟，可重复申请）
        "backgroundModes": [
          "dataTransfer"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 深链：对应 lib/services/deep_link_service.dart 处理的 scheme
            //   fluxdo://topic/123、fluxdo://user/xxx
            //   discourse://auth_redirect?payload=...（浏览器授权登录回调）
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "fluxdo"
              },
              {
                "scheme": "discourse"
              }
            ]
          }
          // TODO(ohos): https://linux.do/t/、/u/、/session/email-login/ 的应用链接
          // 需要先在 AGC 完成 App Linking 域名校验，之后再补：
          // { "scheme": "https", "host": "linux.do", "pathStartWith": "/t/" }
        ]
      }
    ],
    // 依据 docs/ohos/plugin-matrix.md §3.1；受限权限（READ_IMAGEVIDEO 等）刻意不声明。
    // 注：富文本「读」剪贴板 ohos.permission.READ_PASTEBOARD 属 system_basic 级，
    // 普通应用证书安装期即失败（grant request permissions failed），故不声明；
    // 读取走 ClipboardUtils.readHtml()，失败时自动回退纯文本粘贴。
    // 「写」图片到剪贴板不需要该权限（ArkTS 桥 writeImageToPasteboard）。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:reason_camera",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:reason_microphone",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
