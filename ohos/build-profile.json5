{
  "app": {
    // 刻意留空：脚本化构建（tools\build-ohos.ps1）不依赖 hvigor 内置签名。
    // 手工/DevEco 调试签名在构建之后由 tools\ohos-sign.ps1 完成（OpenHarmony 默认证书链）。
    // 注意：若 DevEco Studio 打开工程后自动写入 signingConfigs（含加密密码），
    // assembleHap 会在 SignHap 阶段报 "No permission write to signConfigCheckJson.json"，
    // 需要把这里恢复成空数组再跑脚本构建。
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:\\Users\\iceblock\\.ohos\\config\\default_ohos_<scrubbed>.cer",
          "keyAlias": "debugKey",
          "keyPassword": "<scrubbed>",
          "profile": "C:\\Users\\iceblock\\.ohos\\config\\default_ohos_<scrubbed>.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:\\Users\\iceblock\\.ohos\\config\\default_ohos_<scrubbed>.p12",
          "storePassword": "<scrubbed>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        // DevEco Studio 26 / HarmonyOS 7：必须写完整三段式版本号 "26.0.0"，
        // 写 "5.0.5(17)" 或 "26" 都会在 hvigor 阶段报 SDK 版本非法。
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
