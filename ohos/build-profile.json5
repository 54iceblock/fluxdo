{
  "app": {
    // ⚠️ 本文件必须保持 signingConfigs 为空数组，且**不得提交任何签名材料**。
    //
    // 原因：
    //  1) 脚本化构建（tools\build-ohos.ps1）不依赖 hvigor 内置签名：assembleHap 之后
    //     由 tools\ohos-sign.ps1 用 OpenHarmony 默认证书链手工签名。
    //  2) 一旦这里存在 signingConfigs（含 DevEco 加密后的 keyPassword/storePassword
    //     与开发者本机绝对路径），assembleHap 会在 SignHap 阶段报
    //     "No permission write to signConfigCheckJson.json"，脚本构建直接失败。
    //  3) 这些是本机私密材料，提交进 git 即泄露（即使只是 DevEco 自动生成的调试证书，
    //     也可能被换成正式证书后忘记清理）。
    //
    // DevEco Studio 做「自动签名」时会**自动写回这里**——提交前请检查：
    //     git diff -- ohos/build-profile.json5
    // 或直接跑守卫脚本（CI 同款）：
    //     dart tool/check_no_secrets.dart          # 加 --fix 可自动复位
    //     just check-secrets
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // DevEco Studio 26 / HarmonyOS 7：必须写完整三段式版本号 "26.0.0"，
        // 写 "5.0.5(17)" 或 "26" 都会在 hvigor 阶段报 SDK 版本非法。
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
